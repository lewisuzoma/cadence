# ---------------------------------------------------------------------------
# Cadence — environment template.  Copy to .env:  cp .env.example .env
#
# Two things read this file:
#
#   1. Docker Compose, for the values that are the same everywhere — the
#      secrets, the TTLs, POSTGRES_*, the published ports.
#   2. The host-side commands (`npm run dev`, `npm run db:migrate`, ...),
#      which load it through dotenv-cli.
#
# Anything that DIFFERS between the host and a container is set by
# docker-compose.yml under `environment:`, which overrides `env_file:`.  That
# is why the values below are the HOST ones: DATABASE_URL, DATABASE_URL_TEST,
# NODE_ENV and APP_URL are all overridden inside Compose, so pointing them at
# localhost here cannot affect the Docker stack.
#
# `npm run env:check` verifies your .env has every key this file declares.
# Change the secrets before deploying anywhere real.
# ---------------------------------------------------------------------------

# --- Postgres (the `db` service) -------------------------------------------
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence_dev_password
POSTGRES_DB=cadence

# --- Database URLs ---------------------------------------------------------
# Host values, reaching Compose's Postgres on its published port (DB_PORT).
# Inside Compose the host is the service name instead (`db` / `db-test`), set
# by docker-compose.yml.
DATABASE_URL=postgresql://cadence:cadence_dev_password@localhost:55432/cadence?schema=public
# The isolated test database.  The suite refuses any URL whose name does not
# contain "test", because it resets whatever it is given.
DATABASE_URL_TEST=postgresql://cadence:cadence_dev_password@localhost:55432/cadence_test?schema=public

# --- Auth ------------------------------------------------------------------
# Generate real secrets with:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-fedcba9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Used when the learner ticks "keep me signed in for 30 days" at sign-in.
REFRESH_TOKEN_TTL_REMEMBERED=30d
BCRYPT_COST=12

# --- HTTP ------------------------------------------------------------------
# The host value: `npm run dev` should run in development mode.  Compose sets
# NODE_ENV=production for its own services, so this does not weaken Docker.
NODE_ENV=development
PORT=4000
# Extra origins allowed to call the API, comma-separated.  The stack's own
# origin never needs listing: the server recognises a same-origin request from
# the request itself (server/src/app.ts), so changing CLIENT_PORT is safe.
# This is for genuinely cross-origin callers, e.g. `vite dev` on :5173.
CORS_ORIGIN=http://localhost:5173
# true only behind HTTPS.  Local Compose serves plain http on :8080.
COOKIE_SECURE=false
# Where the SPA is reachable.  Password-reset links are built from this and
# never from the request's Host header, so set it to the public URL.
# Host value: Vite serves the client on :5173 on the non-Docker path.  Compose
# overrides it with the published client port (:8080 by default).
APP_URL=http://localhost:5173
LOG_LEVEL=info

# --- Mail ------------------------------------------------------------------
# The From: on transactional mail (password-reset links).
MAIL_FROM=Cadence <no-reply@cadence.dev>
# No transport is wired up yet: outside production the message is printed to
# the server log, so a reset link can be followed locally with
#   docker compose logs -f api
# Mailtrap SMTP credentials will plug into server/src/lib/mailer.ts.

# --- Published host ports (change if one is already in use) ----------------
CLIENT_PORT=8080
API_PORT=4000
# 55432 rather than the conventional 5432, because a locally installed
# PostgreSQL very often owns 5432 already and the clash is silent: Compose
# starts happily, but `localhost:5432` then reaches the *other* server and
# authentication fails with no hint as to why.  Change it if you prefer, and
# keep DATABASE_URL / DATABASE_URL_TEST above in step with it.
DB_PORT=55432

# --- Client build ----------------------------------------------------------
# Same-origin path served by nginx in Compose.  For `vite dev` outside Docker
# the dev-server proxy handles /api, so this value still works.
VITE_API_URL=/api/v1

# ---------------------------------------------------------------------------
# Instructor feature
# ---------------------------------------------------------------------------

# How long a rejected applicant waits before reapplying. 0 = immediately.
INSTRUCTOR_REAPPLY_COOLDOWN_DAYS=7

# The window that defines an "active" learner in course analytics. Used by
# the stat cards, the active/inactive chart and the learners filter alike,
# so there is one definition rather than three.
ANALYTICS_ACTIVE_DAYS=14

# --- storage ---------------------------------------------------------------
# `local` writes to a Docker volume and needs nothing else configured — it
# is the default so that `docker compose up` gives a reviewer working
# uploads with no cloud account. `s3` talks to the MinIO service in
# docker-compose.yml locally, and to S3 or R2 in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Only read when STORAGE_DRIVER=s3. Compose overrides S3_ENDPOINT with the
# service name; these are the credentials MinIO starts with.
# NEVER commit real credentials: in production these come from the
# environment, not from a file in the repository.
S3_BUCKET=cadence-media
S3_ACCESS_KEY=cadence_minio
S3_SECRET_KEY=cadence_minio_password
S3_REGION=us-east-1
# MinIO requires path-style addressing; S3 tolerates it.
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Upload ceilings, enforced before a presigned URL is issued and again
# against the bytes that actually arrived.
MAX_VIDEO_MB=2048
MAX_IMAGE_MB=5

# Lifetime of a signed upload or playback URL, in seconds.
SIGNED_URL_TTL_SECONDS=900

# Above this size a file is uploaded in parts, so a dropped connection
# costs one part rather than the whole transfer, and re-picking the same
# file resumes from where it stopped. Below it, one request is simpler
# and faster.
UPLOAD_MULTIPART_THRESHOLD_MB=16
# Part size. S3 requires at least 5 MB for every part but the last.
UPLOAD_PART_SIZE_MB=8
