# ---------------------------------------------------------------------------
# Cadence — environment template.  Copy to .env:  cp .env.example .env
# Docker Compose reads this file; every value below has a working default for
# local development.  Change the secrets before deploying anywhere real.
# ---------------------------------------------------------------------------

# --- Postgres (the `db` service) -------------------------------------------
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence_dev_password
POSTGRES_DB=cadence

# --- Database URLs ---------------------------------------------------------
# Inside Compose the host is the service name (`db`), never localhost.
DATABASE_URL=postgresql://cadence:cadence_dev_password@db:5432/cadence?schema=public
# The isolated test database (the `db-test` service, `test` profile).
DATABASE_URL_TEST=postgresql://cadence:cadence_dev_password@db-test:5432/cadence_test?schema=public

# --- Auth ------------------------------------------------------------------
# Generate real secrets with:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-fedcba9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Used when the learner ticks "keep me signed in for 30 days" at sign-in.
REFRESH_TOKEN_TTL_REMEMBERED=30d
BCRYPT_COST=12

# --- HTTP ------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Only used on the non-Docker dev path: in Compose nginx proxies /api, so the
# browser sees one origin and CORS is not involved.
CORS_ORIGIN=http://localhost:5173
# true only behind HTTPS.  Local Compose serves plain http on :8080.
COOKIE_SECURE=false
LOG_LEVEL=info

# --- Published host ports (change if one is already in use) ----------------
CLIENT_PORT=8080
API_PORT=4000
DB_PORT=5432

# --- Client build ----------------------------------------------------------
# Same-origin path served by nginx in Compose.  For `vite dev` outside Docker
# the dev-server proxy handles /api, so this value still works.
VITE_API_URL=/api/v1
